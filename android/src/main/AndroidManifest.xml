<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed on Android 13 and later to show notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
            Receives UnifiedPush events from the connector library. It runs even when the
            app is not in the foreground, and shows or cancels notifications natively.
        -->
        <service
            android:name="dev.capacitorunifiedpush.UnifiedPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
